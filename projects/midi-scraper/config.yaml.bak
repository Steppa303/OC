# midi-scraper Konfiguration
# Alle Pfade sind relativ zum Projektroot

# Ausgabe-Verzeichnis für die MIDI-Sammlung
output_dir: "midi-collection"

# Seed-URLs zum Starten des Scrapings
seed_urls:
  # Haupt-MIDI-Datenbanken
  - "https://www.midiworld.com/"
  - "https://bitmidi.com/"
  - "https://freepats.com/"
  - "https://www.huge-midi.com/"
  - "https://midi-archive.com/"
  - "https://www.midiplus.com/"
  
  # Electronica-spezifische Quellen
  - "https://www.onlinesequencer.net/"
  - "https://mididb.com/"
  - "https://www.vgmusic.com/"
  - "https://www.karaochka.com/"
  - "https://midi.moonlitsound.com/"
  
  # Archive & Community
  - "https://github.com/colinb97/midis"
  - "https://github.com/mborne/midis"
  - "https://github.com/YannickJakob/midi_drum_kit_mapper"
  
  # Additional MIDI Sites
  - "https://www.classicguitar.com/midi/"
  - "https://www.pianosociety.com/midis.php"
  - "https://www.midi.org/"
  - "https://www.angelfire.com/on/aria/midi.htm"
  - "https://midiworld.download/"

# Genre-Keywords zum Filtern elektronischer Musik
