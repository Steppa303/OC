# MacroStack Backend Environment
# Copy to .env and adjust as needed.

# App
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=3723

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3722,http://127.0.0.1:3722

# Redis / RQ
REDIS_URL=redis://redis:6379/0

# Storage
TMP_DIR=/tmp/macrostack
JOB_TTL_SECONDS=86400

# Limits
MAX_IMAGES=30
MAX_FILE_SIZE_MB=100
